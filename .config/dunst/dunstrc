[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (12, 40)
    width = (200, 400)
    height = (0, 300)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 5
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8

    frame_width = 2
    frame_color = "#e0b070"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    corner_radius = 10
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#231f18"
    foreground = "#d1c5b4"
    timeout = 5

[urgency_normal]
    background = "#231f18"
    foreground = "#ebe1d4"
    frame_color = "#e0b070"
    timeout = 8

[urgency_critical]
    background = "#231f18"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0

# ---- Rules ----

# Volume/mic pop-ups from ~/.config/hypr/scripts/volume.sh: brief, kept out of history
[volume-osd]
    appname = osd
    history_ignore = yes
    timeout = 1500ms
    highlight = "#e0b070"

# Spotify track changes: short-lived, kept out of history
[spotify]
    appname = Spotify
    urgency = low
    timeout = 3
    history_ignore = yes
