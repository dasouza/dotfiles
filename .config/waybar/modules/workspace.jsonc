{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "window-rewrite-default": "󰊠",
    "window-rewrite": {
      // --- Work ---
      "ghostty": "󰆍",
      "libreoffice": "󰏆",
      "firefox": "",
      "thunderbird": "",
      "studio": "",
      "code": "󰨞",
      "azahar": "",
      "obsidian": "󰹕",
      "mousepad": "󱓧",
      "kcalc": "",
      // --- Apps ---
      "steam": "",
      "discord": "",
      // Keys are regexes over "class<C> title<T>"; class+title rules outrank class-only ones.
      // Slack puts "N new item(s)" in its title while there are unreads
      "class<slack>": "",
      "class<slack> title<.*\\d+ new item.*>": "<span color='#ff6b5e'></span>",
      "spotify": "",
      "bitwarden": "",
      "org.kde.kdeconnect.app": "󰦉",
      "org.qbittorrent.qBittorrent": "󰘿",
      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "yazi": "󰇥",
      "imv": "󰄄",
      "swappy": "󰄄",
      "org.gnome.FileRoller": "",
      "vlc": "󰕼",
      "mpv": "󰕼",
      // --- System ---
      "dolphin": "",
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",
      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓"
    },
    "format-icons": {
      "active": "",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": true
  }
}
