{
  "custom/tray-arrow": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "notification": "󱅫",
      "none": "󰏖",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/dunst-status.sh",
    "interval": 3,
    "on-click": "dunstctl history-pop",          // re-show last notification
    "on-click-right": "dunstctl set-paused toggle", // do not disturb
    "on-click-middle": "dunstctl history-clear",
    "escape": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "show-passive-items": true
  }
}
